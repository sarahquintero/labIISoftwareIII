<!DOCTYPE html>

<html lang="es-CO">
  <head>
    <style>
      * {
        color: #382ca5;
      }

      button {
        background-color: #007bff;
        color: white;
        padding: 8px 18px;
        border-radius: 10px;
        border: 0;
      }

      #medico1 {
        background-color: #ca5f86;
        border-radius: 5px;
        border: 2px solid red;
        padding-top: 5px;
        padding-right: 15px;
        padding-bottom: 25px;
        padding-left: 15px;
      }

      #medico2 {
        background-color: #cbe79c;
        border-radius: 5px;
        border: 2px solid darkgreen;
        padding-top: 5px;
        padding-right: 15px;
        padding-bottom: 25px;
        padding-left: 15px;
      }

      #medico3 {
        background-color: #a2b9e6;
        border-radius: 5px;
        border: 2px solid darkblue;
        padding-top: 5px;
        padding-right: 15px;
        padding-bottom: 25px;
        padding-left: 15px;
      }

      .grid-container {
        display: grid;
        grid-template-columns: 33% 33% 33%;
        gap: 10px;
        text-align: center;
      }
    </style>
  </head>

  <body style="background-color: black">
    <div style="display: flex;  background-color: blue; margin: auto">
      <img
        src="./684833.png"
        alt="Medico"
        style="
          width: 100px;
          float: left;
          height: auto;
          margin: 0px 200px 0px 10px;
        "
      />
      <h1 style="text-align: center; color: #6d13ba">
        Medicos disponibles para citas
      </h1>
    </div>

    <div class="grid-container">
      <div id="medico1">
        <h1 style="text-align: right">Nombre del medico</h1>
        <p style="text-align: right">
          Años de experiencia y especialidad medica.<br />Biografia breve que
          describa sobre su formacion, enfoque de trabajo.<br />Horario de
          atencion.
        </p>
        <img
          src="./684833.png"
          alt="Medico"
          style="width: 100px; margin: 5px auto; display: block; float: center"
        />
        <button type="button">Agendar Cita</button>
      </div>

      <div id="medico2">
        <h1>Nombre del medico</h1>
        <p>
