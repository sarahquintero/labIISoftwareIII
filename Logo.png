          style="width: 100px; margin: 5px auto; display: block; float: center"
        />
        <button type="button">Agendar Cita</button>
      </div>

      <div id="medico3">
        <h1 style="text-align: left">Nombre del medico</h1>
        <p style="text-align: left">
          Años de experiencia y especialidad medica.<br />Biografia breve que
          describa sobre su formacion, enfoque de trabajo.<br />Horario de
